{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2024", "DOM"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node"]
  },
  "include": ["src", "tests", "e2e", "scripts", "*.ts"],
  "exclude": ["*.tmp.ts"]
}
