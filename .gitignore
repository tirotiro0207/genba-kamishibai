# ローカル専用の設定と秘密
CLAUDE.local.md
.claude/settings.local.json
.env
.env.*
!.env.example

# 作ったもの（録画・同意書・絵の試し・画面の写し・動画の素材・手描き）。GitHub に上げない
private/

# 録画（private/rec の外に出したときの保険）
recordings/
*.mp4
*.mov
*.webm

# 練習で書き出したカード
practice-cards/
exports/

# 測るための仮の台本とデータ
scratch/

# 依存とビルド
node_modules/
dist/
.next/
# テストの結果の XML（CI が書く）
test-results/
__pycache__/

# 最後の確認だけに使う 10 個（中身は入れず、ハッシュだけ入れる）
eval/holdout/

# wrangler の手元の DB と一時ファイル
.wrangler/
.dev.vars

# 道具の作業場（worktree・別の道具の設定）と、手元の仮の台本（tsconfig の *.ts にも当たる）
.claude/worktrees/
.codex/
*.tmp.ts

# 手元のプレビューの設定（各自の環境）
.claude/launch.json
