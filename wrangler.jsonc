{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 手元の名前は本番と分ける。--env production を付け忘れて deploy しても、本番の Worker に手元用の D1 と R2 が載らない
  "name": "genba-kamishibai-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp/*"]
  },
  // 手元とテストの DB と置き場。本番は下の env.production（--env production で出す）
  "d1_databases": [
    { "binding": "DB", "database_name": "genba-kamishibai", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "genba-kamishibai-files" }],
  // 本番（028b）。DB と置き場を手元と分ける。鍵と役割の名前は wrangler secret put --env production で入れる
  "env": {
    "production": {
      "name": "genba-kamishibai",
      // PUBLIC_NAMES: 公開デモでも名前を出してよい枠（公開に同意した人だけ。名前そのものは secret）
      "vars": { "PUBLIC_DEMO": "1", "PUBLIC_NAMES": "author.1,supervisor.1,supervisor.2" },
      "d1_databases": [
        { "binding": "DB", "database_name": "genba-kamishibai-prod", "database_id": "251a60b5-672b-4082-9cd9-3e936d0f6ba6", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "genba-kamishibai-prod-files" }]
    }
  }
}
